# URL de la base de données PostgreSQL (ex: Neon, Supabase, ou Vercel Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-123.region.neon.tech/neondb?sslmode=require"

# Clé secrète forte pour signer les sessions JWT (minimum 32 caractères)
# Générez-en une facilement avec : openssl rand -hex 32
JWT_SECRET="generate-a-super-secure-random-key-64-characters-long"

# URL publique de votre application en production (HTTPS obligatoire)
NEXT_PUBLIC_APP_URL="https://votre-domaine.vercel.app"
